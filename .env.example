# Chave da API Anthropic (obrigatória para gerar respostas)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
LLM_MODEL=claude-sonnet-5

# Embeddings: local | voyage | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# Chunking e retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
CANDIDATE_K=12
MIN_SCORE=0.25
